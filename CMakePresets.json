{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "iphoneos",
      "displayName": "iOS (tools/apple_deps.sh first)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/apple/build-ios",
      "environment": {
        "PKG_CONFIG_LIBDIR": "${sourceDir}/out/apple/prefix-ios/lib/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/out/apple/prefix-ios",
        "CMAKE_PREFIX_PATH": "${sourceDir}/out/apple/prefix-ios",
        "RECOMP_LLVM_DEMANGLE_SRC": "${sourceDir}/out/apple/src/llvm-demangle",
        "RECOMP_LLVM_ROOT": "/opt/homebrew/opt/llvm@22"
      }
    },
    {
      "name": "appletvos",
      "displayName": "tvOS (tools/apple_deps.sh first)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/apple/build-tvos",
      "environment": {
        "PKG_CONFIG_LIBDIR": "${sourceDir}/out/apple/prefix-tvos/lib/pkgconfig",
        "PKG_CONFIG_SYSROOT_DIR": ""
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/out/apple/prefix-tvos",
        "CMAKE_PREFIX_PATH": "${sourceDir}/out/apple/prefix-tvos",
        "RECOMP_LLVM_DEMANGLE_SRC": "${sourceDir}/out/apple/src/llvm-demangle",
        "RECOMP_LLVM_ROOT": "/opt/homebrew/opt/llvm@22"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "iphoneos",
      "configurePreset": "iphoneos"
    },
    {
      "name": "appletvos",
      "configurePreset": "appletvos"
    }
  ]
}
